{
  "name": "slack-knowledge-bot",
  "version": "0.1.0",
  "description": "SlackKnowledgeBot — Slack bot for NanoCorp knowledge retrieval",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "eval": "vitest run --config vitest.eval.config.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "install:all": "npm ci && npm --prefix packages/oauth ci",
    "build:oauth": "npm --prefix packages/oauth run build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run platform:validate && npm run schemas:freshness:test && npm run schemas:freshness:selftest",
    "platform:validate": "node scripts/validate-platform-manifests.mjs && node scripts/validate-platform-manifests.mjs --self-test",
    "schemas:sync": "node scripts/sync-crd-schemas.mjs",
    "schemas:check": "node scripts/sync-crd-schemas.mjs --check",
    "schemas:freshness": "node scripts/sync-crd-schemas.mjs --freshness",
    "schemas:freshness:test": "node scripts/freshness-report-test.mjs",
    "schemas:freshness:selftest": "node scripts/freshness-report-test.mjs --self-test",
    "sync:vendored": "node scripts/sync-vendored.mjs",
    "sync:vendored:check": "node scripts/sync-vendored.mjs --check",
    "sync:vendored:freshness": "node scripts/sync-vendored.mjs --freshness",
    "sync:vendored:selftest": "node scripts/sync-vendored.mjs --self-test",
    "audit:prod": "npm audit --audit-level=high --omit=dev",
    "chart:lint": "helm lint chart",
    "chart:template:staging": "helm template slack-knowledge-bot chart -f chart/values-staging.yaml",
    "chart:template:production": "helm template slack-knowledge-bot chart -f chart/values-production.yaml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/client-kms": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-sqs": "^3.1111.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@slack/bolt": "^5.0.0",
    "@smithy/node-http-handler": "^4.11.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "slack-knowledge-bot-oauth": "file:./packages/oauth",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.4",
    "aws-sdk-client-mock": "^4.1.0",
    "js-yaml": "^5.3.0",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "@grpc/grpc-js": "^1.14.4",
    "form-data": "^4.0.6",
    "protobufjs": "^7.6.5",
    "ws": "^8.21.0",
    "vite": "^8.0.16",
    "esbuild": "^0.28.1",
    "axios": "^1.18.1",
    "body-parser": "^2.3.0",
    "gaxios": "^7.3.0",
    "nanoid": "^3.3.17"
  },
  "engines": {
    "node": ">=24"
  }
}
