{
  "name": "slack-knowledge-bot",
  "version": "0.1.0",
  "description": "SlackKnowledgeBot — Slack bot for NanoCorp knowledge retrieval",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "docs": "echo 'Docs: README.md, AGENTS.md, ARCHITECTURE.md, docs/'",
    "install:all": "npm ci && npm --prefix packages/oauth ci",
    "build:oauth": "npm --prefix packages/oauth run build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run platform:validate",
    "platform:validate": "node scripts/validate-platform-manifest.mjs && node scripts/validate-platform-manifest.mjs --self-test",
    "sync:crd-schemas": "node scripts/sync-crd-schemas.mjs",
    "sync:crd-schemas:check": "node scripts/sync-crd-schemas.mjs --check",
    "sync:vendored": "node scripts/sync-vendored.mjs",
    "sync:vendored:check": "node scripts/sync-vendored.mjs --check",
    "audit:prod": "npm audit --audit-level=high --omit=dev",
    "chart:lint": "helm lint chart",
    "chart:template:staging": "helm template slack-knowledge-bot chart -f chart/values-staging.yaml",
    "chart:template:production": "helm template slack-knowledge-bot chart -f chart/values-production.yaml"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1030.0",
    "@aws-sdk/client-dynamodb": "^3.1030.0",
    "@aws-sdk/client-kms": "^3.1030.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-sqs": "^3.1030.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@slack/bolt": "^4.7.0",
    "@smithy/node-http-handler": "^4.5.2",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "slack-knowledge-bot-oauth": "file:./packages/oauth",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.4",
    "aws-sdk-client-mock": "^4.1.0",
    "js-yaml": "^5.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "qs": "^6.15.2",
    "@grpc/grpc-js": "^1.14.4",
    "form-data": "^4.0.6",
    "protobufjs": "^7.6.5",
    "ws": "^8.21.0",
    "vite": "^8.0.16",
    "esbuild": "^0.28.1",
    "axios": "^1.18.1",
    "body-parser": "^2.3.0",
    "glob": {
      "brace-expansion": "^2.1.2"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
