# Release-age floor, in days: npm resolves no version published more recently
# than this, so no tree here is the first to install a compromised publish.
# Set here, npm applies it wherever it resolves a version for this project: a
# local npm install or npm update, and every lockfile Renovate writes, lock file
# maintenance included, since Renovate passes npm no --before date of its own
# when this file sets min-release-age. Versions a lockfile already records
# install as recorded, so npm ci is unaffected. npm reads the key from 11.10.0
# on; earlier npm ignores it.
#
# For routine updates, keep it at or below minimumReleaseAge in the shared
# Renovate preset (github>nanohype/.github). Renovate ages each such update
# against that value before proposing it, and a higher floor here makes npm
# refuse a version Renovate has already aged and selected, so Renovate skips
# that update.
#
# Security updates are held to this floor too. The preset sets
# minimumReleaseAge to null under vulnerabilityAlerts, so Renovate proposes a
# CVE fix at any age, but a null there does not lift a package manager's own
# floor, and min-release-age-exclude exempts packages by name, not updates by
# kind. npm refuses a fix younger than this floor, Renovate creates no branch
# for it, and the security PR opens on Renovate's first run after the fix has
# aged past the floor. To take a younger fix by hand, pass --min-release-age=0
# to the npm install or npm update that moves the lockfile to it; the flag
# outranks this file for that one command.
#
# packages/oauth/.npmrc holds the same floor for that package's own lockfile,
# and CI fails when the two disagree.
min-release-age=3
