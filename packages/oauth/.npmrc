# Release-age floor, in days: npm resolves no version published more recently
# than this, so this package is never the first to install a compromised
# publish. Keep it equal to the repository root's .npmrc, which explains where
# the floor applies, how it relates to minimumReleaseAge in the shared Renovate
# preset (github>nanohype/.github), and how it holds security updates. CI fails
# when the two files disagree.
#
# npm takes project config only from the nearest directory holding a
# package.json, which for this package is this one, and Renovate writes this
# package's lockfile with this directory's .npmrc, so the root's floor does not
# reach it.
min-release-age=3
